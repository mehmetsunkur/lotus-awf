FROM node:22-bookworm-slim

RUN npm install -g @openai/codex@0.145.0 @anthropic-ai/claude-code@2.1.218

RUN mkdir -p /runner /work /diag /home/node/.codex /home/node/.claude \
  && chown -R node:node /runner /work /diag /home/node

USER node
WORKDIR /work

ENV HOME=/home/node

CMD ["sh", "-lc", "codex --version && claude --version"]
