APP_DB=expense_app
APP_USER=user:alice
LOCAL_COUCH_URL=http://admin:password@localhost:5985
SERVER_COUCH_URL=http://admin:password@localhost:5984
LOCAL_COUCH_REPLICATION_URL=http://admin:password@local-couchdb:5984
SERVER_COUCH_REPLICATION_URL=http://admin:password@server-couchdb:5984
API_PORT=3001

# Real-agent MCP acceptance suite (`npm run test:mcp:agent`, opt-in).
# Copy this file to `.env` (gitignored) and fill in real values. Each driver
# self-skips when its own vars are absent, so you can configure only one.
# Do NOT commit real tokens — keep them in `.env`, never `.env.example`.

# Claude Code driver
ANTHROPIC_BASE_URL=https://your-litellm-claude-endpoint
ANTHROPIC_AUTH_TOKEN=your-claude-proxy-token
LOTUS_AGENT_MODEL=claude-opus-4-8
# LOTUS_AGENT_BUDGET_USD=2.00   # optional per-run cost cap

# Codex driver (LiteLLM provider, OpenAI-compatible /v1)
CODEX_BASE_URL=https://your-litellm-codex-endpoint/v1
CODEX_AUTH_TOKEN=your-codex-proxy-token
CODEX_MODEL=gpt-5.5
