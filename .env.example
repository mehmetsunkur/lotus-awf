APP_DB=expense_app
APP_USER=user:alice
LOCAL_COUCH_URL=http://admin:password@localhost:5985
SERVER_COUCH_URL=http://admin:password@localhost:5984
LOCAL_COUCH_REPLICATION_URL=http://admin:password@local-couchdb:5984
SERVER_COUCH_REPLICATION_URL=http://admin:password@server-couchdb:5984
API_PORT=3001

# Real-agent MCP acceptance suite (`npm run test:mcp:agent`, opt-in).
# Copy this file to `.env` (gitignored) and fill in real values. Each driver
# self-skips when its own vars are absent, so you can configure only one.
# Do NOT commit real tokens — keep them in `.env`, never `.env.example`.

# Pick which agents run (comma-separated allowlist). Unset/"all" = every driver.
# e.g. LOTUS_AGENT_DRIVERS=codex  or  LOTUS_AGENT_DRIVERS=claude-code,codex
# LOTUS_AGENT_DRIVERS=claude-code,codex

# Claude Code driver. LOTUS_AGENT_CLAUDE_* are mapped to the provider-native
# ANTHROPIC_* the claude CLI reads, and fall back to ANTHROPIC_* when unset
# (so inside a Claude Code session, where ANTHROPIC_* are injected, no config is needed).
LOTUS_AGENT_CLAUDE_BASE_URL=https://your-litellm-claude-endpoint
LOTUS_AGENT_CLAUDE_TOKEN=your-claude-proxy-token
LOTUS_AGENT_CLAUDE_MODEL=claude-opus-4-8
# LOTUS_AGENT_CLAUDE_BUDGET_USD=2.00   # optional per-run cost cap

# Codex driver (LiteLLM provider, OpenAI-compatible /v1)
LOTUS_AGENT_CODEX_BASE_URL=https://your-litellm-codex-endpoint/v1
LOTUS_AGENT_CODEX_TOKEN=your-codex-proxy-token
LOTUS_AGENT_CODEX_MODEL=gpt-5.5
