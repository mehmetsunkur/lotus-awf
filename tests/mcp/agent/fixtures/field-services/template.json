    {
      "_id": "workflow:service-request",
      "kind": "workflow",
      "appId": "field-services",
      "docType": "service-request",
      "title": "Service Request Intake",
      "description": "How dispatch handles an incoming request: triage it, then either convert it to a work order or decline it.",
      "initialState": "new",
      "states": [
        {
          "name": "new",
          "label": "New",
          "description": "Just submitted; awaiting dispatch triage. No one has assessed it yet.",
          "responsible": "group:dispatch"
        },
        {
          "name": "triaged",
          "label": "Triaged",
          "description": "Dispatch has reviewed it and confirmed the details; ready to convert to a work order or decline.",
          "responsible": "group:dispatch"
        },
        {
          "name": "converted",
          "label": "Converted",
          "description": "Accepted and turned into a work order. Terminal — the job now lives on the work order.",
          "final": true
        },
        {
          "name": "declined",
          "label": "Declined",
          "description": "Dispatch decided not to act on the request. Terminal.",
          "final": true
        }
      ],
      "transitions": [
        {
          "id": "triage",
          "label": "Triage",
          "description": "Dispatch confirms a new request's details and moves it to triaged.",
          "from": "new",
          "to": "triaged",
          "requiredRole": "group:dispatch",
          "action": "audit-transition"
        },
        {
          "id": "convert",
          "label": "Convert to work order",
          "description": "Accept a triaged request; the follow-up work is created as a separate work-order document.",
          "from": "triaged",
          "to": "converted",
          "requiredRole": "group:dispatch",
          "action": "audit-transition"
        },
        {
          "id": "decline",
          "label": "Decline",
          "description": "Reject a triaged request that will not be actioned.",
          "from": "triaged",
          "to": "declined",
          "requiredRole": "group:dispatch",
          "action": "audit-transition"
        }
      ]
    },
    {
      "_id": "workflow:work-order",
      "kind": "workflow",
      "appId": "field-services",
      "docType": "work-order",
      "title": "Work Order Fulfillment",
      "description": "The technician's job lifecycle: start scheduled work, optionally divert through inventory for parts, then complete it (which hands off to billing) — or cancel at any point.",
      "initialState": "scheduled",
      "states": [
        {
          "name": "scheduled",
          "label": "Scheduled",
          "description": "Assigned to a technician with a date, not yet started. Responsibility resolves to the named technician via responsibleFormula.",
          "responsible": "group:technicians",
          "responsibleFormula": "payload.technician"
        },
        {
          "name": "in-progress",
          "label": "In progress",
          "description": "The technician is actively working the job. From here they can request parts or complete once work and billable hours are recorded.",
          "responsible": "group:technicians",
          "responsibleFormula": "payload.technician"
        },
        {
          "name": "needs-parts",
          "label": "Needs parts",
          "description": "Work is paused pending inventory: the technician has requested parts and is waiting for them to be marked ready.",
          "responsible": "group:inventory"
        },
        {
          "name": "parts-ready",
          "label": "Parts ready",
          "description": "Inventory has fulfilled the parts request; the technician can resume work or complete directly.",
          "responsible": "group:technicians",
          "responsibleFormula": "payload.technician"
        },
        {
          "name": "completed",
          "label": "Completed",
          "description": "Work is done and captured; responsibility passes to billing to raise an invoice.",
          "responsible": "group:billing"
        },
        {
          "name": "cancelled",
          "label": "Cancelled",
          "description": "Called off before completion (from any non-final state). Terminal.",
          "final": true
        }
      ],
      "transitions": [
        {
          "id": "start",
          "label": "Start work",
          "description": "The assigned technician begins the job. Guard: the actor must be the named technician or a member of group:technicians.",
          "from": "scheduled",
          "to": "in-progress",
          "guard": "principals.includes(payload.technician) || principals.includes('group:technicians')",
          "action": "audit-transition"
        },
        {
          "id": "request-parts",
          "label": "Request parts",
          "description": "Technician pauses the job to source parts; typically paired with creating a parts-reservation document for inventory.",
          "from": "in-progress",
          "to": "needs-parts",
          "requiredRole": "group:technicians",
          "action": "audit-transition"
        },
        {
          "id": "parts-ready",
          "label": "Mark parts ready",
          "description": "Inventory signals the requested parts are available so the technician can proceed.",
          "from": "needs-parts",
          "to": "parts-ready",
          "requiredRole": "group:inventory",
          "action": "audit-transition"
        },
        {
          "id": "resume-after-parts",
          "label": "Resume after parts",
          "description": "Technician returns a parts-ready job to active work.",
          "from": "parts-ready",
          "to": "in-progress",
          "requiredRole": "group:technicians",
          "action": "audit-transition"
        },
        {
          "id": "complete",
          "label": "Complete",
          "description": "Finish an in-progress job. Guard requires workPerformed to be filled and billableHours to be zero or more.",
          "from": "in-progress",
          "to": "completed",
          "guard": "!!payload.workPerformed && payload.billableHours >= 0",
          "requiredRole": "group:technicians",
          "action": "audit-transition"
        },
        {
          "id": "complete-after-parts",
          "label": "Complete after parts",
          "description": "Finish directly from parts-ready without a separate resume step. Same completion guard as complete.",
          "from": "parts-ready",
          "to": "completed",
          "guard": "!!payload.workPerformed && payload.billableHours >= 0",
          "requiredRole": "group:technicians",
          "action": "audit-transition"
        },
        {
          "id": "cancel",
          "label": "Cancel",
          "description": "Dispatch calls off the job from any non-final state.",
          "from": "*",
          "to": "cancelled",
          "requiredRole": "group:dispatch",
          "action": "audit-transition"
        }
      ]
    },
    {
      "_id": "workflow:parts-reservation",
      "kind": "workflow",
      "appId": "field-services",
      "docType": "parts-reservation",
      "title": "Parts Reservation",
      "description": "How inventory fulfills a technician's parts request: allocate from stock (or backorder then receive), and finally hand the parts to the technician.",
      "initialState": "requested",
      "states": [
        {
          "name": "requested",
          "label": "Requested",
          "description": "A technician has asked for parts; inventory needs to allocate them or backorder if short.",
          "responsible": "group:inventory"
        },
        {
          "name": "allocated",
          "label": "Allocated",
          "description": "Stock is reserved for this job and waiting for the technician to collect.",
          "responsible": "group:technicians"
        },
        {
          "name": "picked-up",
          "label": "Picked up",
          "description": "The technician has taken the parts. Terminal.",
          "final": true
        },
        {
          "name": "backordered",
          "label": "Backordered",
          "description": "Not in stock; awaiting replenishment before it can be allocated. Requires a shortageReason.",
          "responsible": "group:inventory"
        }
      ],
      "transitions": [
        {
          "id": "allocate",
          "label": "Allocate",
          "description": "Inventory reserves in-stock parts for the request.",
          "from": "requested",
          "to": "allocated",
          "requiredRole": "group:inventory",
          "action": "audit-transition"
        },
        {
          "id": "backorder",
          "label": "Backorder",
          "description": "Inventory flags a shortage; guard requires shortageReason to explain what is missing.",
          "from": "requested",
          "to": "backordered",
          "guard": "!!payload.shortageReason",
          "requiredRole": "group:inventory",
          "action": "audit-transition"
        },
        {
          "id": "receive-stock",
          "label": "Receive stock",
          "description": "Replenishment arrives; a backordered request becomes allocated.",
          "from": "backordered",
          "to": "allocated",
          "requiredRole": "group:inventory",
          "action": "audit-transition"
        },
        {
          "id": "pick-up",
          "label": "Pick up",
          "description": "The technician collects the allocated parts, closing the reservation.",
          "from": "allocated",
          "to": "picked-up",
          "requiredRole": "group:technicians",
          "action": "audit-transition"
        }
      ]
    },
    {
      "_id": "workflow:invoice",
      "kind": "workflow",
      "appId": "field-services",
      "docType": "invoice",
      "title": "Invoice Collection",
      "description": "Billing's path from a draft bill to payment: prepare, send, and record payment — with side paths to dispute/resolve or void.",
      "initialState": "draft",
      "states": [
        {
          "name": "draft",
          "label": "Draft",
          "description": "Initial bill being prepared by billing; can be marked ready or disputed if it does not match the work order.",
          "responsible": "group:billing"
        },
        {
          "name": "ready",
          "label": "Ready",
          "description": "Reviewed and ready to send to the customer.",
          "responsible": "group:billing"
        },
        {
          "name": "sent",
          "label": "Sent",
          "description": "Issued to the customer; awaiting payment.",
          "responsible": "group:billing"
        },
        {
          "name": "disputed",
          "label": "Disputed",
          "description": "A discrepancy was raised (discrepancyNote required); needs resolution back to draft.",
          "responsible": "group:billing"
        },
        {
          "name": "paid",
          "label": "Paid",
          "description": "Payment recorded against the invoice. Terminal.",
          "final": true
        },
        {
          "name": "void",
          "label": "Void",
          "description": "Cancelled and no longer collectible (voidReason required). Terminal.",
          "final": true
        }
      ],
      "transitions": [
        {
          "id": "mark-ready",
          "label": "Mark ready",
          "description": "Billing finalizes a draft for issue.",
          "from": "draft",
          "to": "ready",
          "requiredRole": "group:billing",
          "action": "audit-transition"
        },
        {
          "id": "send",
          "label": "Send",
          "description": "Issue the ready invoice to the customer.",
          "from": "ready",
          "to": "sent",
          "requiredRole": "group:billing",
          "action": "audit-transition"
        },
        {
          "id": "record-payment",
          "label": "Record payment",
          "description": "Mark a sent invoice paid; guard requires a paymentReference.",
          "from": "sent",
          "to": "paid",
          "guard": "!!payload.paymentReference",
          "requiredRole": "group:billing",
          "action": "audit-transition"
        },
        {
          "id": "dispute",
          "label": "Dispute",
          "description": "Flag a discrepancy on a draft; guard requires discrepancyNote.",
          "from": "draft",
          "to": "disputed",
          "guard": "!!payload.discrepancyNote",
          "requiredRole": "group:billing",
          "action": "audit-transition"
        },
        {
          "id": "resolve-dispute",
          "label": "Resolve dispute",
          "description": "Return a disputed invoice to draft for correction.",
          "from": "disputed",
          "to": "draft",
          "requiredRole": "group:billing",
          "action": "audit-transition"
        },
        {
          "id": "void",
          "label": "Void",
          "description": "Cancel the invoice from any non-final state (voidReason required on the document).",
          "from": "*",
          "to": "void",
          "requiredRole": "group:billing",
          "action": "audit-transition"
        }
      ]
    }
  ]
}
