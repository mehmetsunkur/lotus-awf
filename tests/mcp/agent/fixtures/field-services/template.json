    {
      "_id": "workflow:service-request",
      "kind": "workflow",
      "appId": "field-services",
      "docType": "service-request",
      "title": "Service Request Intake",
      "initialState": "new",
      "states": [
        {
          "name": "new",
          "label": "New",
          "responsible": "group:dispatch"
        },
        {
          "name": "triaged",
          "label": "Triaged",
          "responsible": "group:dispatch"
        },
        {
          "name": "converted",
          "label": "Converted",
          "final": true
        },
        {
          "name": "declined",
          "label": "Declined",
          "final": true
        }
      ],
      "transitions": [
        {
          "id": "triage",
          "label": "Triage",
          "from": "new",
          "to": "triaged",
          "requiredRole": "group:dispatch",
          "action": "audit-transition"
        },
        {
          "id": "convert",
          "label": "Convert to work order",
          "from": "triaged",
          "to": "converted",
          "requiredRole": "group:dispatch",
          "action": "audit-transition"
        },
        {
          "id": "decline",
          "label": "Decline",
          "from": "triaged",
          "to": "declined",
          "requiredRole": "group:dispatch",
          "action": "audit-transition"
        }
      ]
    },
    {
      "_id": "workflow:work-order",
      "kind": "workflow",
      "appId": "field-services",
      "docType": "work-order",
      "title": "Work Order Fulfillment",
      "initialState": "scheduled",
      "states": [
        {
          "name": "scheduled",
          "label": "Scheduled",
          "responsible": "group:technicians",
          "responsibleFormula": "payload.technician"
        },
        {
          "name": "in-progress",
          "label": "In progress",
          "responsible": "group:technicians",
          "responsibleFormula": "payload.technician"
        },
        {
          "name": "needs-parts",
          "label": "Needs parts",
          "responsible": "group:inventory"
        },
        {
          "name": "parts-ready",
          "label": "Parts ready",
          "responsible": "group:technicians",
          "responsibleFormula": "payload.technician"
        },
        {
          "name": "completed",
          "label": "Completed",
          "responsible": "group:billing"
        },
        {
          "name": "cancelled",
          "label": "Cancelled",
          "final": true
        }
      ],
      "transitions": [
        {
          "id": "start",
          "label": "Start work",
          "from": "scheduled",
          "to": "in-progress",
          "guard": "principals.includes(payload.technician) || principals.includes('group:technicians')",
          "action": "audit-transition"
        },
        {
          "id": "request-parts",
          "label": "Request parts",
          "from": "in-progress",
          "to": "needs-parts",
          "requiredRole": "group:technicians",
          "action": "audit-transition"
        },
        {
          "id": "parts-ready",
          "label": "Mark parts ready",
          "from": "needs-parts",
          "to": "parts-ready",
          "requiredRole": "group:inventory",
          "action": "audit-transition"
        },
        {
          "id": "resume-after-parts",
          "label": "Resume after parts",
          "from": "parts-ready",
          "to": "in-progress",
          "requiredRole": "group:technicians",
          "action": "audit-transition"
        },
        {
          "id": "complete",
          "label": "Complete",
          "from": "in-progress",
          "to": "completed",
          "guard": "!!payload.workPerformed && payload.billableHours >= 0",
          "requiredRole": "group:technicians",
          "action": "audit-transition"
        },
        {
          "id": "complete-after-parts",
          "label": "Complete after parts",
          "from": "parts-ready",
          "to": "completed",
          "guard": "!!payload.workPerformed && payload.billableHours >= 0",
          "requiredRole": "group:technicians",
          "action": "audit-transition"
        },
        {
          "id": "cancel",
          "label": "Cancel",
          "from": "*",
          "to": "cancelled",
          "requiredRole": "group:dispatch",
          "action": "audit-transition"
        }
      ]
    },
    {
      "_id": "workflow:parts-reservation",
      "kind": "workflow",
      "appId": "field-services",
      "docType": "parts-reservation",
      "title": "Parts Reservation",
      "initialState": "requested",
      "states": [
        {
          "name": "requested",
