        {
          "title": "Completion",
          "fields": [
            "workPerformed",
            "billableHours"
          ]
        }
      ],
      "fields": [
        {
          "name": "requestRef",
          "type": "select",
          "label": "Service request",
          "source": {
            "docType": "service-request",
            "labelField": "payload.customer"
          }
        },
        {
          "name": "customer",
          "type": "text",
          "label": "Customer",
          "required": true,
          "searchable": true
        },
        {
          "name": "site",
          "type": "text",
          "label": "Site",
          "required": true,
          "searchable": true
        },
        {
          "name": "serviceType",
          "type": "select",
          "label": "Service type",
          "required": true,
          "defaultValue": "repair",
          "options": [
            {
              "label": "Repair",
              "value": "repair"
            },
            {
              "label": "Install",
              "value": "install"
            },
            {
              "label": "Inspection",
              "value": "inspection"
            }
          ]
        },
        {
          "name": "technician",
          "type": "text",
          "label": "Technician",
          "required": true,
          "helpText": "Principal assigned by dispatch, such as person:taylor or group:technicians."
        },
        {
          "name": "scheduledDate",
          "type": "date",
          "label": "Scheduled date",
          "required": true
        },
        {
          "name": "estimatedHours",
          "type": "number",
          "label": "Estimated hours",
          "validate": [
            {
              "expression": "!payload.estimatedHours || payload.estimatedHours > 0",
              "message": "Estimated hours must be greater than zero"
            }
          ]
        },
        {
          "name": "workPerformed",
          "type": "textarea",
          "label": "Work performed",
          "requiredWhen": "doc.state == 'in-progress' || doc.state == 'parts-ready'"
        },
        {
          "name": "billableHours",
          "type": "number",
          "label": "Billable hours",
          "requiredWhen": "doc.state == 'in-progress' || doc.state == 'parts-ready'",
          "validate": [
            {
              "expression": "!payload.billableHours || payload.billableHours >= 0",
              "message": "Billable hours cannot be negative"
            }
          ]
        }
      ]
    },
