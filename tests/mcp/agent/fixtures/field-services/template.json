    {
      "_id": "app:config",
      "kind": "app",
      "appId": "field-services",
      "title": "Field Services",
      "description": "Field service operations: dispatch triages incoming service requests, converts them to scheduled work orders, technicians complete the work (requesting parts from inventory when needed), and billing invoices the completed job through to payment.",
      "database": "field_services_app"
    },
    {
      "_id": "audit:policy",
      "kind": "auditpolicy",
      "appId": "field-services",
      "retentionDays": 365
    },
    {
      "_id": "form:service-request",
      "kind": "form",
      "appId": "field-services",
      "docType": "service-request",
      "title": "Service Request",
      "description": "A customer's incoming request for field work — who and where, the reported problem, and its priority. Dispatch triages these and converts the accepted ones into work orders.",
      "defaultReaders": [
        "group:dispatch",
        "group:managers"
      ],
      "sections": [
        {
          "title": "Customer",
          "fields": [
            "customer",
            "site",
            "contact"
          ]
        },
        {
          "title": "Request",
          "fields": [
            "problem",
            "priority",
            "requestedDate"
          ]
        }
      ],
      "fields": [
        {
          "name": "customer",
          "type": "text",
          "label": "Customer",
          "required": true,
          "searchable": true
        },
        {
          "name": "site",
          "type": "text",
          "label": "Site",
          "required": true,
          "searchable": true
        },
        {
          "name": "contact",
          "type": "text",
          "label": "Contact",
          "required": true
        },
        {
          "name": "problem",
          "type": "textarea",
          "label": "Problem",
          "required": true,
          "searchable": true
        },
        {
          "name": "priority",
          "type": "select",
          "label": "Priority",
          "required": true,
          "defaultValue": "standard",
          "options": [
            {
              "label": "Emergency",
              "value": "emergency"
            },
            {
              "label": "Standard",
              "value": "standard"
            },
            {
              "label": "Planned",
              "value": "planned"
            }
          ]
        },
        {
          "name": "requestedDate",
          "type": "date",
          "label": "Requested date",
          "required": true
        }
      ]
    },
    {
      "_id": "form:work-order",
      "kind": "form",
      "appId": "field-services",
      "docType": "work-order",
      "title": "Work Order",
      "description": "The scheduled job a technician performs on site: the originating request, customer/site, service type, schedule, and the work-performed / billable-hours captured at completion. Feeds parts reservations and, once completed, an invoice.",
      "defaultReaders": [
        "group:dispatch",
        "group:technicians",
        "group:inventory",
        "group:billing",
        "group:managers"
      ],
      "sections": [
        {
          "title": "Job",
          "fields": [
            "requestRef",
            "customer",
            "site",
            "serviceType"
          ]
        },
        {
          "title": "Schedule",
          "fields": [
            "technician",
            "scheduledDate",
            "estimatedHours"
          ]
        },
        {
          "title": "Completion",
          "fields": [
            "workPerformed",
            "billableHours"
          ]
        }
      ],
      "fields": [
        {
          "name": "requestRef",
          "type": "select",
          "label": "Service request",
          "source": {
            "docType": "service-request",
            "labelField": "payload.customer"
          }
        },
        {
          "name": "customer",
          "type": "text",
          "label": "Customer",
          "required": true,
          "searchable": true
        },
        {
          "name": "site",
          "type": "text",
          "label": "Site",
          "required": true,
          "searchable": true
        },
        {
          "name": "serviceType",
          "type": "select",
          "label": "Service type",
          "required": true,
          "defaultValue": "repair",
          "options": [
            {
              "label": "Repair",
              "value": "repair"
            },
            {
              "label": "Install",
              "value": "install"
            },
            {
              "label": "Inspection",
              "value": "inspection"
            }
          ]
        },
        {
          "name": "technician",
          "type": "text",
          "label": "Technician",
          "required": true,
          "helpText": "Principal assigned by dispatch, such as person:taylor or group:technicians."
        },
        {
          "name": "scheduledDate",
          "type": "date",
          "label": "Scheduled date",
          "required": true
        },
        {
          "name": "estimatedHours",
          "type": "number",
          "label": "Estimated hours",
          "validate": [
            {
              "expression": "!payload.estimatedHours || payload.estimatedHours > 0",
              "message": "Estimated hours must be greater than zero"
            }
          ]
        },
        {
          "name": "workPerformed",
          "type": "textarea",
          "label": "Work performed",
          "requiredWhen": "doc.state == 'in-progress' || doc.state == 'parts-ready'"
        },
        {
          "name": "billableHours",
          "type": "number",
          "label": "Billable hours",
          "requiredWhen": "doc.state == 'in-progress' || doc.state == 'parts-ready'",
          "validate": [
            {
              "expression": "!payload.billableHours || payload.billableHours >= 0",
              "message": "Billable hours cannot be negative"
            }
          ]
        }
      ]
    },
