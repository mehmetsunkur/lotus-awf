{
  "name": "lotus-notes-m1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"tsx watch src/server/index.ts\" \"vite --host 0.0.0.0 --port 3000\"",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "replicate": "tsx scripts/replicate.ts",
    "force-conflict": "tsx scripts/force-conflict.ts",
    "force-state-conflict": "tsx scripts/force-state-conflict.ts",
    "acl-spike": "tsx scripts/acl-spike.ts",
    "app": "tsx scripts/app.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test:serve": "E2E=1 concurrently -n api,web -c cyan,green \"tsx src/server/index.ts\" \"vite --host 0.0.0.0 --port 3000\"",
    "test:unit": "vitest run",
    "test:mcp": "playwright test -c playwright.mcp.config.ts",
    "test:e2e": "playwright test",
    "test:deploy": "tsx tests/deploy/deploy-artifact.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "ulid": "^2.3.0",
    "vite": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "vitest": "^4.1.9"
  }
}
